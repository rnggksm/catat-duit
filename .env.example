# Salin menjadi .env:  cp .env.example .env
# Nilai di bawah hanya untuk development lokal.

POSTGRES_USER=catatduit
POSTGRES_PASSWORD=catatduit
POSTGRES_DB=catatduit

# Dipakai saat menjalankan API di luar Docker (npm run start:dev di laptop).
DATABASE_URL=postgresql://catatduit:catatduit@localhost:5432/catatduit?schema=public

PORT=3000
# Ganti dengan string acak panjang (mis. hasil `openssl rand -hex 32`).
JWT_ACCESS_SECRET=ganti-dengan-string-acak-panjang
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
# true jika diakses lewat HTTPS (Caddy / tunnel)
COOKIE_SECURE=false

# Akun demo yang dibuat oleh `npm run seed` (khusus lokal)
SEED_DEMO_EMAIL=demo@catatduit.test
SEED_DEMO_PASSWORD=demo12345
SEED_DEMO_NAME=Demo
