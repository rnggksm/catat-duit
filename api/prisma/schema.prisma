// Skema Catat Duit — Tahap 1
// Nominal disimpan sebagai BigInt dalam Rupiah utuh. Waktu disimpan UTC.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MemberRole {
  OWNER
  MEMBER
}

enum WalletType {
  CASH
  BANK
  EWALLET
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

enum InsightStatus {
  NEW
  DISMISSED
  TRYING
}

/// Rumah tangga: unit kepemilikan data. Satu user punya satu household saat daftar;
/// pasangan bergabung ke household yang sama lewat undangan (Fase 2).
model Household {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  periodStartDay Int      @default(25) @map("period_start_day")
  timezone       String   @default("Asia/Jakarta")
  createdAt      DateTime @default(now()) @map("created_at")

  members      HouseholdMember[]
  wallets      Wallet[]
  categories   Category[]
  transactions Transaction[]
  insights     Insight[]
  budgets      Budget[]
  invites      HouseholdInvite[]

  @@map("households")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at")

  memberships   HouseholdMember[]
  refreshTokens RefreshToken[]
  transactions  Transaction[]
  invitesSent   HouseholdInvite[] @relation("InviteSent")
  invitesUsed   HouseholdInvite[] @relation("InviteUsed")

  @@map("users")
}

model HouseholdMember {
  householdId String     @map("household_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  role        MemberRole @default(MEMBER)
  joinedAt    DateTime   @default(now()) @map("joined_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([householdId, userId])
  @@index([userId])
  @@map("household_members")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Wallet {
  id             String     @id @default(uuid()) @db.Uuid
  householdId    String     @map("household_id") @db.Uuid
  name           String
  type           WalletType
  initialBalance BigInt     @default(0) @map("initial_balance")
  isShared       Boolean    @default(true) @map("is_shared")
  ownerUserId    String?    @map("owner_user_id") @db.Uuid
  sortOrder      Int        @default(0) @map("sort_order")
  archived       Boolean    @default(false)
  createdAt      DateTime   @default(now()) @map("created_at")

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([householdId, name])
  @@map("wallets")
}

model Category {
  id          String       @id @default(uuid()) @db.Uuid
  householdId String       @map("household_id") @db.Uuid
  parentId    String?      @map("parent_id") @db.Uuid
  name        String
  /// Nama huruf kecil tanpa spasi berlebih, untuk mencegah duplikat "Makan" vs "makan".
  nameKey     String       @map("name_key")
  type        CategoryType @default(EXPENSE)
  icon        String
  color       String
  isEssential Boolean      @default(true) @map("is_essential")
  sortOrder   Int          @default(0) @map("sort_order")
  archived    Boolean      @default(false)
  createdAt   DateTime     @default(now()) @map("created_at")

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent       Category?     @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[]    @relation("CategoryTree")
  transactions Transaction[]
  budgets      Budget[]

  @@unique([householdId, type, nameKey])
  @@index([householdId, sortOrder])
  @@map("categories")
}

model Transaction {
  /// Dibuat di klien (UUID v4) supaya input offline idempotent saat sinkron.
  id              String          @id @default(uuid()) @db.Uuid
  householdId     String          @map("household_id") @db.Uuid
  walletId        String          @map("wallet_id") @db.Uuid
  categoryId      String          @map("category_id") @db.Uuid
  createdById     String          @map("created_by") @db.Uuid
  type            TransactionType @default(EXPENSE)
  amount          BigInt
  occurredAt      DateTime        @map("occurred_at")
  note            String?
  clientUpdatedAt DateTime        @default(now()) @map("client_updated_at")
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  wallet    Wallet    @relation(fields: [walletId], references: [id], onDelete: Restrict)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([householdId, occurredAt])
  @@index([householdId, categoryId, occurredAt])
  @@map("transactions")
}

/// Saran penghematan per periode (PRD 5.7). Dibuat ulang tiap laporan dibuka;
/// `status` pilihan pengguna tetap tersimpan.
model Insight {
  id              String        @id @default(uuid()) @db.Uuid
  householdId     String        @map("household_id") @db.Uuid
  periodStart     DateTime      @map("period_start")
  ruleCode        String        @map("rule_code")
  /// Subjek aturan, mis. id kategori. Kosong untuk aturan tingkat periode.
  subjectKey      String        @default("") @map("subject_key")
  title           String
  message         String
  potentialSaving BigInt        @default(0) @map("potential_saving")
  data            Json          @default("{}")
  status          InsightStatus @default(NEW)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, periodStart, ruleCode, subjectKey])
  @@index([householdId, periodStart])
  @@map("insights")
}

/// Anggaran (PRD 5.6), opsional. Satu baris = nilai yang berlaku MULAI periode `effectiveFrom`
/// dan terbawa ke periode berikutnya sampai ada baris lebih baru. amount 0 = anggaran dihapus.
model Budget {
  id            String    @id @default(uuid()) @db.Uuid
  householdId   String    @map("household_id") @db.Uuid
  /// id kategori induk, atau "TOTAL" untuk anggaran total periode.
  subjectKey    String    @map("subject_key")
  categoryId    String?   @map("category_id") @db.Uuid
  amount        BigInt
  effectiveFrom DateTime  @map("effective_from")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, subjectKey, effectiveFrom])
  @@index([householdId, effectiveFrom])
  @@map("budgets")
}

/// Undangan bergabung ke household (Fase 2). Token mentah hanya dikirim sekali lewat tautan;
/// yang disimpan hanya hash SHA-256, sama seperti RefreshToken.
///
/// Status tidak disimpan sebagai kolom: diturunkan dari `acceptedAt`, `revokedAt`, dan
/// `expiresAt` supaya tidak ada dua sumber kebenaran yang bisa berbeda.
model HouseholdInvite {
  id           String     @id @default(uuid()) @db.Uuid
  householdId  String     @map("household_id") @db.Uuid
  /// Email tujuan, huruf kecil. Undangan terikat email agar tautan yang tersebar tidak bisa dipakai orang lain.
  email        String
  tokenHash    String     @unique @map("token_hash")
  role         MemberRole @default(MEMBER)
  invitedById  String     @map("invited_by") @db.Uuid
  expiresAt    DateTime   @map("expires_at")
  acceptedAt   DateTime?  @map("accepted_at")
  acceptedById String?    @map("accepted_by") @db.Uuid
  revokedAt    DateTime?  @map("revoked_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy  User      @relation("InviteSent", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy User?     @relation("InviteUsed", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt])
  @@index([householdId, email])
  @@map("household_invites")
}
